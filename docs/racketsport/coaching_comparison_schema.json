{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinkvision.local/schemas/coaching_comparison_schema.json",
  "title": "Evidence-linked user versus reference coaching comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "comparison_basis",
    "user",
    "reference",
    "shot",
    "user_phase_anchors",
    "alignment",
    "cues",
    "abstention_reasons",
    "source_artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "racketsport_coaching_comparison"},
    "status": {"enum": ["ready", "kinematics_only", "abstained"]},
    "comparison_basis": {"enum": ["reference_motion", "published_rubric", "self_relative"]},
    "user": {"$ref": "#/$defs/userClip"},
    "reference": {
      "oneOf": [
        {"$ref": "#/$defs/motionReferenceClip"},
        {"$ref": "#/$defs/embedOnlyReferenceClip"},
        {"$ref": "#/$defs/linkOnlyReferenceClip"}
      ]
    },
    "shot": {"$ref": "#/$defs/shot"},
    "user_phase_anchors": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/userPhaseAnchor"}
    },
    "alignment": {
      "oneOf": [
        {"$ref": "#/$defs/alignment"},
        {"type": "null"}
      ]
    },
    "cues": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/cue"}
    },
    "abstention_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/evidenceReference"}
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t0", "t1"],
      "properties": {
        "t0": {"type": "number", "minimum": 0},
        "t1": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "userClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "player_id", "replay_manifest_sha256", "interval"],
      "properties": {
        "clip_id": {"type": "string", "minLength": 1},
        "player_id": {"type": "integer", "minimum": 0},
        "replay_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "interval": {"$ref": "#/$defs/interval"}
      }
    },
    "motionReferenceClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "athlete_name",
        "reference_set_id",
        "exemplar_id",
        "source_url",
        "replay_manifest_url",
        "replay_manifest_sha256",
        "player_id",
        "interval",
        "handedness",
        "display_rights",
        "expert_reviewed"
      ],
      "properties": {
        "athlete_name": {"type": "string", "minLength": 1},
        "reference_set_id": {"type": "string", "minLength": 1},
        "exemplar_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "replay_manifest_url": {"type": "string", "minLength": 1},
        "replay_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "player_id": {"type": "integer", "minimum": 0},
        "interval": {"$ref": "#/$defs/interval"},
        "handedness": {"enum": ["left", "right"]},
        "display_rights": {
          "enum": ["cleared", "local_review_only"],
          "description": "The user-facing viewer accepts motion comparison only when cleared; local_review_only is retained for internal abstention and audit artifacts."
        },
        "expert_reviewed": {"type": "boolean"}
      }
    },
    "embedOnlyReferenceClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "athlete_name",
        "reference_set_id",
        "exemplar_id",
        "source_url",
        "embed_url",
        "display_rights",
        "expert_reviewed"
      ],
      "properties": {
        "athlete_name": {"type": "string", "minLength": 1},
        "reference_set_id": {"type": "string", "minLength": 1},
        "exemplar_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "embed_url": {"type": "string", "minLength": 1},
        "display_rights": {"const": "official_embed_only"},
        "expert_reviewed": {"type": "boolean"}
      }
    },
    "linkOnlyReferenceClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "athlete_name",
        "reference_set_id",
        "exemplar_id",
        "source_url",
        "display_rights",
        "expert_reviewed"
      ],
      "properties": {
        "athlete_name": {"type": "string", "minLength": 1},
        "reference_set_id": {"type": "string", "minLength": 1},
        "exemplar_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "display_rights": {"const": "official_link_only"},
        "expert_reviewed": {"type": "boolean"}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "label_source", "confidence", "context_tags"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "label_source": {"enum": ["human_reviewed", "model_estimated"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "context_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "phase_anchors", "spatial", "quality"],
      "properties": {
        "method": {"const": "monotonic_phase_map_v1"},
        "phase_anchors": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/readyAnchor"},
            {"$ref": "#/$defs/loadAnchor"},
            {"$ref": "#/$defs/forwardAnchor"},
            {"$ref": "#/$defs/strikeAnchor"},
            {"$ref": "#/$defs/finishAnchor"}
          ],
          "items": false
        },
        "spatial": {"$ref": "#/$defs/spatialAlignment"},
        "quality": {"$ref": "#/$defs/alignmentQuality"}
      }
    },
    "phaseAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "user_t", "reference_t", "confidence"],
      "properties": {
        "phase": {"enum": ["ready", "load", "forward", "strike_window", "finish"]},
        "user_t": {"type": "number", "minimum": 0},
        "reference_t": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "userPhaseAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "user_t", "confidence"],
      "properties": {
        "phase": {"enum": ["ready", "load", "forward", "strike_window", "finish"]},
        "user_t": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "readyAnchor": {
      "allOf": [
        {"$ref": "#/$defs/phaseAnchor"},
        {"properties": {"phase": {"const": "ready"}}}
      ]
    },
    "loadAnchor": {
      "allOf": [
        {"$ref": "#/$defs/phaseAnchor"},
        {"properties": {"phase": {"const": "load"}}}
      ]
    },
    "forwardAnchor": {
      "allOf": [
        {"$ref": "#/$defs/phaseAnchor"},
        {"properties": {"phase": {"const": "forward"}}}
      ]
    },
    "strikeAnchor": {
      "allOf": [
        {"$ref": "#/$defs/phaseAnchor"},
        {"properties": {"phase": {"const": "strike_window"}}}
      ]
    },
    "finishAnchor": {
      "allOf": [
        {"$ref": "#/$defs/phaseAnchor"},
        {"properties": {"phase": {"const": "finish"}}}
      ]
    },
    "spatialAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_space",
        "pelvis_centered",
        "facing_yaw_deg",
        "uniform_scale",
        "mirrored",
        "scale_label"
      ],
      "properties": {
        "comparison_space": {"enum": ["body_local", "court_world"]},
        "pelvis_centered": {"type": "boolean"},
        "facing_yaw_deg": {"type": "number"},
        "uniform_scale": {"type": "number", "exclusiveMinimum": 0},
        "mirrored": {"type": "boolean"},
        "scale_label": {"enum": ["metric", "body_size_normalized"]}
      }
    },
    "alignmentQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "confidence", "abstention_reasons"],
      "properties": {
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "abstention_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "phase", "headline", "instruction", "visual", "measurement", "claim_boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "phase": {"enum": ["ready", "load", "forward", "strike_window", "finish"]},
        "headline": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "visual": {"$ref": "#/$defs/cueVisual"},
        "measurement": {"$ref": "#/$defs/cueMeasurement"},
        "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
      }
    },
    "cueVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "joint_names", "preferred_view", "reference_overlay"],
      "properties": {
        "kind": {"enum": ["joint_arrow", "angle_arc", "phase_timing", "stance_outline"]},
        "joint_names": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preferred_view": {"enum": ["front", "side", "rear"]},
        "reference_overlay": {"enum": ["ghost", "none"]}
      }
    },
    "cueMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "metric_id",
        "user_value",
        "reference_value",
        "delta",
        "unit",
        "provenance",
        "authority",
        "confidence",
        "evidence_locators"
      ],
      "properties": {
        "domain": {"enum": ["kinematics", "contact"]},
        "metric_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "user_value": {"type": "number"},
        "reference_value": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["model_estimated", "measured"]},
        "authority": {"enum": ["verified", "preview", "low_confidence", "too_close_to_call"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceReference"}
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinematics", "contact", "causality", "reason"],
      "properties": {
        "kinematics": {"enum": ["supported", "abstained"]},
        "contact": {"enum": ["supported", "not_verified", "abstained"]},
        "causality": {"const": "not_established"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "artifact_type",
        "uri",
        "sha256",
        "json_pointer",
        "role",
        "provenance_band",
        "authority_band",
        "gate_id",
        "gate_status"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "artifact_type": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "role": {"enum": ["user_motion", "reference_motion", "published_rubric", "shot_label", "phase_alignment", "contact", "expert_review"]},
        "provenance_band": {"enum": ["measured", "model_estimated", "physics_predicted", "missing"]},
        "authority_band": {"enum": ["verified", "preview", "low_confidence", "too_close_to_call"]},
        "gate_id": {"type": ["string", "null"]},
        "gate_status": {"enum": ["pass", "unpassed", "not_applicable"]}
      }
    }
  }
}
